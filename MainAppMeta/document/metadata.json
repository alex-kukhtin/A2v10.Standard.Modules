{
	"table": "StockDocuments",
	"model": "Document",
	"traits": [ "Print", "Attachments" ],
	"fields": {
		"Number": {
			"type": "Autonum"
		},
		"Operation": {
			"type": "Operation"
		},
		"StoreFrom": {
			"type": "Ref",
			"target": "/catalog/store"
		},
		"StoreTo": {
			"type": "Ref",
			"target": "/catalog/store"
		},
		"Agent": {
			"type": "Ref",
			"target": "/catalog/agent"
		},
		"Sum": {
			"type": "Amount"
		}
	},
	"rules": {
		"required": [ "Date" ],
		"computed": {
			"Sum": "this.StockRows.$sum(r => r.Sum) + this.ServiceRows.$sum(r => r.Sum)"
		}
	},
	"details": {
		"Rows": {
			"model": "Row",
			"fields": {
				"Kind": {
					"type": "RowKind"
				},
				"Qty": {
					"type": "Qty"
				},
				"Price": {
					"type": "Price"
				},
				"Sum": {
					"type": "Amount"
				},
				"Item": {
					"type": "Ref",
					"target": "/catalog/item"
				},
				"Unit": {
					"type": "Ref",
					"target": "/catalog/unit"
				}
			},
			"lookup": {
				"Item": [ "Article", "Barcode" ]
			},
			"rules": {
				"inherit": {
					"Unit": {
						"ref": "Item",
						"field": "Unit"
					}
				}
			},
			"kinds": {
				"Stock": {
					"rules": {
						"computed": {
							"Sum": "this.Qty * this.Price"
						},
						"required": [ "Item", "Qty", "Price" ]
					}
				},
				"Service": {
					"computed": {
						"Sum": "this.Qty * this.Price"
					},
					"rules": {
						"required": [ "Item" ]
					}
				}
			}
		}
	}
}